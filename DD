<!DOCTYPE html>
<html lang="zh-CN">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>滴滴 | 热线客服专员招聘</title>
	<!-- 引入EmailJS SDK -->
	<script type="text/javascript" src="https://cdn.jsdelivr.net/npm/emailjs-com@3/dist/email.min.js"></script>
	<style>
		:root {
			--primary-color: #FF7D41;
			--primary-hover: #E56020;
			--primary-light: rgba(255, 125, 65, 0.1);
			--bg-color: #f5f5f7;
			--card-bg: #ffffff;
			--text-main: #1d1d1f;
			--text-secondary: #86868b;
			--text-light: #a1a1a6;
			--border-color: #d2d2d7;
			--radius-sm: 8px;
			--radius-md: 12px;
			--radius-lg: 16px;
			--shadow-sm: 0 1px 5px rgba(0, 0, 0, 0.05);
			--shadow-md: 0 4px 20px rgba(0, 0, 0, 0.1);
			--shadow-lg: 0 8px 32px rgba(0, 0, 0, 0.12);
			--transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
		}

		* {
			margin: 0;
			padding: 0;
			box-sizing: border-box;
		}

		body {
			font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
			background-color: var(--bg-color);
			color: var(--text-main);
			line-height: 1.5;
			-webkit-font-smoothing: antialiased;
			font-size: 16px;
		}

		/* 禁止复制功能 */
		.no-select {
			-webkit-user-select: none;
			-moz-user-select: none;
			-ms-user-select: none;
			user-select: none;
		}

		/* 允许表单元素内复制 */
		input, textarea, .allow-select {
			-webkit-user-select: text;
			-moz-user-select: text;
			-ms-user-select: text;
			user-select: text;
		}

		.container {
			max-width: 980px;
			margin: 0 auto;
			padding: 0 22px;
		}

		/* 头部导航 */
		.header {
			background-color: rgba(255, 255, 255, 0.9);
			backdrop-filter: saturate(180%) blur(20px);
			position: sticky;
			top: 0;
			z-index: 100;
			border-bottom: 1px solid rgba(0, 0, 0, 0.08);
			height: 64px;
			padding: 0 20px;
		}

		.header-content {
			display: flex;
			justify-content: space-between;
			align-items: center;
			height: 100%;
			max-width: 980px;
			margin: 0 auto;
		}

		.logo {
			display: flex;
			align-items: center;
			gap: 12px;
		}

		.logo svg {
			height: 32px;
			width: auto;
		}

		.badge {
			background: rgba(255, 125, 65, 0.1);
			color: var(--primary-color);
			padding: 6px 12px;
			border-radius: 20px;
			font-size: 14px;
			font-weight: 500;
		}

		/* 主视觉区 - 优化间距 */
		.hero {
			padding: 30px 0 20px; /* 减少底部间距，让职位详情上移 */
			text-align: center;
		}

		.job-title {
			font-size: 64px;
			font-weight: 700;
			margin-bottom: 16px;
			letter-spacing: -0.5px;
			color: var(--primary-color);
		}

		.job-subtitle {
			font-size: 28px;
			color: var(--text-secondary);
			margin-bottom: 20px; /* 减少间距 */
			max-width: 600px;
			margin-left: auto;
			margin-right: auto;
			font-weight: 400;
			line-height: 1.4;
		}

		.job-subtitle-line {
			display: block;
		}

		.job-subtitle-line:first-child {
			margin-bottom: 6px;
		}

		.address {
			display: inline-flex;
			align-items: center;
			background: rgba(255, 255, 255, 0.9);
			padding: 12px 28px;
			border-radius: 30px;
			font-size: 17px;
			color: var(--text-secondary);
			margin-bottom: 20px; /* 减少间距 */
			backdrop-filter: blur(10px);
			border: 1px solid rgba(0, 0, 0, 0.05);
		}

		.tags {
			display: flex;
			gap: 10px;
			justify-content: center;
			margin-bottom: 30px; /* 减少间距 */
			flex-wrap: wrap;
		}

		.tag {
			background: rgba(255, 125, 65, 0.1);
			color: var(--primary-color);
			padding: 12px 20px;
			border-radius: 20px;
			font-size: 16px;
			font-weight: 500;
		}

		/* 卡片设计 */
		.card {
			background: var(--card-bg);
			border-radius: var(--radius-lg);
			padding: 48px;
			margin-bottom: 24px;
			box-shadow: var(--shadow-sm);
			transition: var(--transition);
		}

		.card:hover {
			box-shadow: var(--shadow-md);
			transform: translateY(-2px);
		}

		.section-title {
			font-size: 32px;
			font-weight: 600;
			margin-bottom: 28px;
			color: var(--primary-color);
		}

		/* 职位详情 */
		.details {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
			gap: 20px;
			margin-bottom: 28px;
		}

		.detail {
			background: var(--bg-color);
			padding: 24px;
			border-radius: var(--radius-md);
			border-left: 4px solid var(--primary-color);
		}

		.detail-label {
			font-size: 14px;
			color: var(--text-secondary);
			margin-bottom: 10px;
		}

		.detail-value {
			font-weight: 600;
			font-size: 20px;
		}

		/* 职位描述 */
		.jd-list {
			list-style: none;
			font-size: 18px;
			color: var(--text-main);
		}

		.jd-list li {
			position: relative;
			padding-left: 28px;
			margin-bottom: 14px;
		}

		.jd-list li::before {
			content: '';
			position: absolute;
			left: 0;
			top: 10px;
			width: 10px;
			height: 10px;
			background: var(--primary-color);
			border-radius: 50%;
		}

		/* 表单设计 */
		.form-grid {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 24px;
		}

		.form-group {
			margin-bottom: 24px;
		}

		.full-width {
			grid-column: 1 / -1;
		}

		label {
			display: block;
			font-size: 15px;
			margin-bottom: 10px;
			font-weight: 500;
			color: var(--text-main);
		}

		input, select, textarea {
			width: 100%;
			padding: 16px 18px;
			border: 1px solid var(--border-color);
			border-radius: var(--radius-md);
			font-size: 16px;
			transition: var(--transition);
			background: var(--card-bg);
		}

		input:focus, select:focus, textarea:focus {
			border-color: var(--primary-color);
			outline: none;
			box-shadow: 0 0 0 4px rgba(255, 125, 65, 0.1);
		}

		/* 文件上传 */
		.file-upload {
			border: 2px dashed var(--border-color);
			border-radius: var(--radius-md);
			padding: 48px;
			text-align: center;
			margin-bottom: 24px;
			cursor: pointer;
			transition: var(--transition);
		}

		.file-upload:hover {
			border-color: var(--primary-color);
			background: rgba(255, 125, 65, 0.03);
		}

		.file-icon {
			font-size: 48px;
			color: var(--primary-color);
			margin-bottom: 16px;
		}

		.file-text {
			color: var(--text-secondary);
			margin-bottom: 16px;
			font-size: 16px;
		}

		.file-btn {
			display: inline-block;
			background: var(--primary-color);
			color: white;
			padding: 12px 24px;
			border-radius: var(--radius-md);
			font-size: 15px;
			font-weight: 500;
			transition: var(--transition);
		}

		.file-btn:hover {
			background: var(--primary-hover);
		}

		.file-name {
			margin-top: 16px;
			font-size: 15px;
			color: var(--primary-color);
			font-weight: 500;
		}

		.file-input {
			display: none;
		}

		/* 提交按钮 */
		.submit-btn {
			width: 100%;
			padding: 18px;
			background: var(--primary-color);
			color: white;
			border: none;
			border-radius: var(--radius-md);
			font-size: 18px;
			font-weight: 500;
			cursor: pointer;
			transition: var(--transition);
			margin-top: 24px;
		}

		.submit-btn:hover {
			background: var(--primary-hover);
			transform: translateY(-2px);
			box-shadow: 0 4px 20px rgba(255, 125, 65, 0.3);
		}

		.submit-btn:active {
			transform: translateY(0);
		}

		.submit-btn:disabled {
			background: #ccc;
			cursor: not-allowed;
			transform: none;
			box-shadow: none;
		}

		/* 加载动画 */
		.spinner {
			display: inline-block;
			width: 20px;
			height: 20px;
			border: 3px solid rgba(255, 255, 255, 0.3);
			border-radius: 50%;
			border-top-color: white;
			animation: spin 1s ease-in-out infinite;
			margin-right: 8px;
			vertical-align: middle;
		}

		@keyframes spin {
			to { transform: rotate(360deg); }
		}

		/* 协议文本 */
		.agreement {
			font-size: 14px;
			text-align: center;
			margin-top: 24px;
			color: var(--text-light);
		}

		.agreement a {
			color: var(--primary-color);
			text-decoration: none;
			font-weight: 500;
		}

		/* 错误提示样式 */
		.error-message {
			color: #ff4d4f;
			font-size: 13px;
			margin-top: 8px;
			display: none;
		}

		input.error, select.error, .file-upload.error {
			border-color: #ff4d4f;
		}

		/* 模态框 */
		.modal {
			display: none;
			position: fixed;
			top: 0;
			left: 0;
			width: 100%;
			height: 100%;
			background: rgba(0, 0, 0, 0.5);
			align-items: center;
			justify-content: center;
			z-index: 1000;
			padding: 20px;
		}

		.modal-content {
			background: var(--card-bg);
			border-radius: var(--radius-lg);
			padding: 48px;
			max-width: 600px;
			width: 100%;
			max-height: 85vh;
			overflow-y: auto;
			box-shadow: var(--shadow-lg);
			position: relative;
			-webkit-overflow-scrolling: touch; /* 启用iOS惯性滚动 */
		}

		.modal-header {
			margin-bottom: 28px;
			padding-bottom: 20px;
			border-bottom: 2px solid var(--primary-light);
		}

		.modal-title {
			font-size: 28px;
			font-weight: 600;
			color: var(--primary-color);
			margin-bottom: 10px;
		}

		.modal-subtitle {
			font-size: 15px;
			color: var(--text-secondary);
		}

		.privacy-content, .disclaimer-content {
			line-height: 1.7;
		}

		.privacy-section, .disclaimer-section {
			margin-bottom: 24px;
		}

		.privacy-section-title, .disclaimer-section-title {
			font-size: 17px;
			font-weight: 600;
			color: var(--text-main);
			margin-bottom: 12px;
			padding-left: 12px;
			border-left: 3px solid var(--primary-color);
		}

		.privacy-paragraph, .disclaimer-paragraph {
			font-size: 15px;
			color: var(--text-secondary);
			margin-bottom: 14px;
			text-align: justify;
		}

		.privacy-list, .disclaimer-list {
			margin: 14px 0 24px 20px;
		}

		.privacy-list li, .disclaimer-list li {
			font-size: 15px;
			color: var(--text-secondary);
			margin-bottom: 10px;
			line-height: 1.5;
		}

		.modal-close {
			position: absolute;
			top: 24px;
			right: 24px;
			background: none;
			border: none;
			font-size: 28px;
			color: var(--text-light);
			cursor: pointer;
			width: 44px;
			height: 44px;
			display: flex;
			align-items: center;
			justify-content: center;
			border-radius: 50%;
			transition: var(--transition);
		}

		.modal-close:hover {
			background: var(--bg-color);
			color: var(--text-main);
		}

		/* 成功模态框 */
		.success-modal {
			text-align: center;
			padding: 60px 40px;
			max-width: 500px;
		}

		.success-icon {
			width: 80px;
			height: 80px;
			background: linear-gradient(135deg, #34C759 0%, #2ED158 100%);
			border-radius: 50%;
			display: flex;
			align-items: center;
			justify-content: center;
			margin: 0 auto 28px;
			animation: iconScale 0.6s cubic-bezier(0.68, -0.55, 0.265, 1.55);
		}

		.success-icon-inner {
			font-size: 40px;
			color: white;
			font-weight: 700;
		}

		.success-title {
			font-size: 32px;
			font-weight: 700;
			color: var(--text-main);
			margin-bottom: 20px;
			letter-spacing: -0.5px;
			animation: textFade 0.6s 0.2s both;
		}

		.success-text {
			font-size: 18px;
			color: var(--text-secondary);
			margin-bottom: 32px;
			line-height: 1.6;
			animation: textFade 0.6s 0.3s both;
		}

		.success-details {
			background: rgba(0, 0, 0, 0.02);
			border-radius: var(--radius-md);
			padding: 24px;
			margin-bottom: 32px;
			text-align: left;
			animation: textFade 0.6s 0.4s both;
		}

		.success-detail {
			display: flex;
			align-items: flex-start;
			margin-bottom: 20px;
		}

		.success-detail:last-child {
			margin-bottom: 0;
		}

		.success-detail-icon {
			font-size: 20px;
			margin-right: 12px;
			flex-shrink: 0;
			color: #34C759;
			width: 24px;
			text-align: center;
		}

		.success-detail-content {
			flex: 1;
		}

		.success-detail-title {
			font-size: 16px;
			font-weight: 600;
			color: var(--text-main);
			margin-bottom: 4px;
			line-height: 1.4;
		}

		.success-detail-text {
			font-size: 15px;
			color: var(--text-secondary);
			line-height: 1.5;
		}

		.success-detail-text strong {
			color: var(--text-main);
			font-weight: 600;
		}

		@keyframes iconScale {
			0% {
				transform: scale(0);
				opacity: 0;
			}
			50% {
				transform: scale(1.2);
			}
			100% {
				transform: scale(1);
				opacity: 1;
			}
		}

		@keyframes textFade {
			0% {
				opacity: 0;
				transform: translateY(20px);
			}
			100% {
				opacity: 1;
				transform: translateY(0);
			}
		}

		/* 页脚 */
		.footer {
			text-align: center;
			padding: 48px 0;
			font-size: 14px;
			color: var(--text-light);
			border-top: 1px solid var(--border-color);
			margin-top: 80px;
		}

		.footer-links {
			margin-bottom: 20px;
		}

		.footer-links a {
			color: var(--text-secondary);
			text-decoration: none;
			margin: 0 14px;
			transition: var(--transition);
			font-size: 15px;
		}

		.footer-links a:hover {
			color: var(--primary-color);
		}

		.footer-notice {
			font-size: 13px;
			color: var(--text-light);
			margin-top: 10px;
		}

		/* 响应式设计 */
		@media (max-width: 768px) {
			.container {
				padding: 0 16px;
			}
			
			.hero {
				padding: 20px 0 15px; /* 移动端也减少间距 */
			}
			
			.job-title {
				font-size: 52px;
			}
			
			.job-subtitle {
				font-size: 24px;
				margin-bottom: 15px;
			}
			
			.form-grid {
				grid-template-columns: 1fr;
			}
			
			.card {
				padding: 32px;
			}
			
			.file-upload {
				padding: 36px 24px;
			}
			
			.modal-content {
				padding: 36px 24px;
			}
			
			.modal-title {
				font-size: 24px;
			}
			
			.success-modal {
				padding: 40px 24px;
			}
			
			.success-icon {
				width: 70px;
				height: 70px;
			}
			
			.success-icon-inner {
				font-size: 36px;
			}
			
			.success-title {
				font-size: 28px;
			}
			
			.footer-links a {
				margin: 0 10px;
			}
			
			.header-content {
				max-width: 100%;
				padding: 0 16px;
			}
		}

		@media (max-width: 480px) {
			.job-title {
				font-size: 42px;
			}
			
			.job-subtitle {
				font-size: 20px;
			}
			
			.address {
				font-size: 15px;
				padding: 10px 24px;
			}
			
			.tag {
				font-size: 14px;
				padding: 10px 18px;
			}
			
			.section-title {
				font-size: 26px;
			}
			
			.modal-content {
				padding: 28px 20px;
			}
			
			.modal-header {
				margin-bottom: 24px;
			}
			
			.modal-title {
				font-size: 22px;
			}
			
			.success-modal {
				padding: 32px 20px;
			}
			
			.success-icon {
				width: 60px;
				height: 60px;
			}
			
			.success-icon-inner {
				font-size: 32px;
			}
			
			.success-title {
				font-size: 24px;
			}
			
			.success-text {
				font-size: 16px;
			}
			
			.success-detail {
				margin-bottom: 16px;
			}
			
			.privacy-section-title, .disclaimer-section-title {
				font-size: 16px;
			}
			
			.privacy-paragraph, .privacy-list li, .disclaimer-paragraph, .disclaimer-list li {
				font-size: 14px;
			}
			
			.header {
				height: 60px;
			}
			
			.logo svg {
				height: 28px;
			}
			
			.badge {
				font-size: 13px;
				padding: 5px 10px;
			}
		}
	</style>
</head>
<body class="no-select">
	<!-- 头部导航 -->
	<header class="header">
		<div class="header-content">
			<div class="logo">
				<svg viewBox="0 0 110 40" xmlns="http://www.w3.org/2000/svg">
					<g fill="#FF7D41">
						<path d="M15,5 C25,5 32,12 32,20 C32,28 25,35 15,35 L5,35 L5,5 L15,5 Z M15,12 L12,12 L12,28 L15,28 C20,28 24,24 24,20 C24,16 20,12 15,12 Z"/>
						<circle cx="38" cy="10" r="4"/>
						<path d="M42,15 L34,15 L34,35 L42,35 L42,15 Z"/>
						<path d="M60,5 C70,5 77,12 77,20 C77,28 70,35 60,35 L50,35 L50,5 L60,5 Z M60,12 L57,12 L57,28 L60,28 C65,28 69,24 69,20 C69,16 65,12 60,12 Z"/>
						<circle cx="83" cy="10" r="4"/>
						<path d="M87,15 L79,15 L79,35 L87,35 L87,15 Z"/>
					</g>
				</svg>
			</div>
			<div class="badge">社会招聘</div>
		</div>
	</header>

	<!-- 主视觉区 -->
	<section class="hero">
		<div class="container">
			<h1 class="job-title">热线客服专员</h1>
			<p class="job-subtitle">
				<span class="job-subtitle-line">加入滴滴出行，为用户提供专业、贴心的</span>
				<span class="job-subtitle-line">服务体验，开启职业新征程</span>
			</p>
			<div class="address">📍 南昌市红谷滩区用友产业园E栋8楼</div>
			<div class="tags">
				<span class="tag">晋升完备</span>
				<span class="tag">五险一金</span>
				<span class="tag">带薪培训</span>
				<span class="tag">团队氛围好</span>
				<span class="tag">双休无加班</span>
			</div>
		</div>
	</section>

	<main class="container">
		<!-- 职位详情卡片 -->
		<div class="card">
			<h2 class="section-title">职位详情</h2>
			<div class="details">
				<div class="detail">
					<div class="detail-label">薪资范围</div>
					<div class="detail-value">4.5K - 7.5K</div>
				</div>
				<div class="detail">
					<div class="detail-label">学历要求</div>
					<div class="detail-value">中专及以上</div>
